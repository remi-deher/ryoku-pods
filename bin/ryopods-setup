#!/bin/bash
# Builds and enables the librepods daemon that this plugin reads from.
# Usage: ryopods-setup [/path/to/daemon]
# With no argument it builds the daemon shipped in this plugin (daemon/, a modified copy of
# librepods, GPLv3, see daemon/UPSTREAM.md). The build happens in the cache, not in the plugin.
# Missing build packages are installed through pkexec (declared in the manifest).

set -euo pipefail

plugin="$(dirname "$(readlink -f "$0")")/.."
daemon="$(readlink -f "${1:-$plugin/daemon}")"
if [ ! -f "$daemon/CMakeLists.txt" ]; then
  echo "usage: ryopods-setup [/path/to/daemon]   (the folder that contains CMakeLists.txt)" >&2
  exit 2
fi
build="${XDG_CACHE_HOME:-$HOME/.cache}/ryoku/plugins/ryoku-pods/build"
share="$HOME/.local/share/librepods"

needed=(cmake ninja qt6-connectivity qt6-tools qt6-declarative pkgconf libpulse)
missing=()
for p in "${needed[@]}"; do
  pacman -Q "$p" >/dev/null 2>&1 || missing+=("$p")
done
if [ "${#missing[@]}" -gt 0 ]; then
  # Explicit user action only: the script is run by hand, and pkexec shows its own prompt.
  echo "Installing missing packages (polkit prompt): ${missing[*]}"
  pkexec pacman -S --needed --noconfirm cmake ninja qt6-connectivity qt6-tools qt6-declarative pkgconf libpulse
fi

cmake -S "$daemon" -B "$build" -G Ninja -DBUILD_TESTING=OFF
cmake --build "$build"
cmake --install "$build" --prefix "$HOME/.local"
# Kept outside the build folder so ryopods-remove works after the cache is cleaned.
mkdir -p "$share"
cp "$build/install_manifest.txt" "$share/install_manifest.txt"

systemctl --user daemon-reload
systemctl --user enable librepods.service
# restart rather than --now, so an already-running daemon picks up the new binary.
systemctl --user restart librepods.service

echo "librepods is running; the bar glyph appears once AirPods are connected."
