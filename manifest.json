{
  "id": "ryoku-pods",
  "name": "AirPods",
  "version": "0.2.2",
  "status": "experimental",
  "author": "Rémi DEHER <56632525+remi-deher@users.noreply.github.com>",
  "description": "AirPods in the Ryoku bar: per-pod and case battery, listening mode, adaptive noise level, conversation awareness, one-bud ANC and ear detection.",
  "license": "MIT",
  "official": false,
  "hosts": [
    "topbarGlyph"
  ],
  "entryPoints": {
    "main": "service/Main.qml",
    "content": "content/Widget.qml",
    "panel": "content/Panel.qml"
  },
  "panel": {
    "width": 340
  },
  "files": [
    "bin/ryopods-setup",
    "bin/ryopods-remove",
    "bin/ryopods-connect",
    "content/AirPodsIcon.qml",
    "content/Segmented.qml",
    "service/Model.js",
    "tests/model.test.js"
  ],
  "capabilities": {
    "densities": [
      "glyph",
      "compact"
    ],
    "privileged": [
      "pkexec pacman -S --needed --noconfirm cmake ninja qt6-connectivity qt6-tools qt6-declarative pkgconf libpulse"
    ]
  },
  "defaults": {
    "host": "topbarGlyph",
    "label": "AirPods"
  },
  "dependencies": {
    "commands": [
      "librepods-ctl",
      "bluetoothctl",
      "notify-send"
    ],
    "packages": [
      "cmake",
      "ninja",
      "qt6-connectivity",
      "qt6-tools",
      "qt6-declarative",
      "pkgconf",
      "libpulse"
    ]
  },
  "metadata": {
    "settings": [
      {
        "key": "hideWhenDisconnected",
        "type": "toggle",
        "label": "Hide the icon when no AirPods are connected",
        "group": "AirPods",
        "default": true
      },
      {
        "key": "showPercentOnGlyph",
        "type": "toggle",
        "label": "Show the battery percentage next to the icon",
        "group": "AirPods",
        "default": true
      },
      {
        "key": "batteryDisplay",
        "type": "choice",
        "label": "Battery shown on the bar",
        "group": "AirPods",
        "default": "lowest",
        "options": [
          {
            "value": "lowest",
            "label": "Lowest pod"
          },
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "right",
            "label": "Right"
          },
          {
            "value": "case",
            "label": "Case"
          }
        ]
      },
      {
        "key": "rightClickAction",
        "type": "choice",
        "label": "Right click on the icon",
        "group": "AirPods",
        "default": "cycle",
        "options": [
          {
            "value": "cycle",
            "label": "Cycle listening mode"
          },
          {
            "value": "none",
            "label": "Nothing"
          }
        ]
      },
      {
        "key": "lowBatteryThreshold",
        "type": "slider",
        "label": "Low battery threshold (%)",
        "group": "Battery",
        "default": 20,
        "min": 5,
        "max": 50,
        "step": 5
      },
      {
        "key": "notifyLowBattery",
        "type": "toggle",
        "label": "Notify when a battery gets low",
        "group": "Battery",
        "default": true
      }
    ]
  }
}
