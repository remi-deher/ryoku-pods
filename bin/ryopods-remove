#!/bin/bash
# Stops the librepods daemon and removes what ryopods-setup installed.
# Usage: ryopods-remove
set -euo pipefail

manifest="$HOME/.local/share/librepods/install_manifest.txt"
systemctl --user disable --now librepods.service || true
if [ -f "$manifest" ]; then
  xargs rm -f < "$manifest"
  rm -rf "$HOME/.local/share/librepods"
else
  echo "no install manifest at $manifest: daemon files left in ~/.local" >&2
fi
systemctl --user daemon-reload
# Pairing secrets (magicAccIRK, magicAccEncKey), the published status line and the build cache.
rm -rf "$HOME/.config/AirPodsTrayApp" "$HOME/.local/state/librepods" \
  "${XDG_CACHE_HOME:-$HOME/.cache}/ryoku/plugins/ryoku-pods/build"
echo "librepods removed."
