+void MediaController::caStartRamp(double to, double tauMs, bool restoreCurve) {
+    m_caRestoreCurve = restoreCurve;
+    m_caRampFrom = m_caLevel;
+    m_caRampTo = to;
+    m_caTauMs = tauMs;
+    m_caRampStartMs = QDateTime::currentMSecsSinceEpoch();
+    m_caRampTimer->start();
+}
+
+void MediaController::caRampTick() {
+    const double t = static_cast<double>(QDateTime::currentMSecsSinceEpoch() - m_caRampStartMs);
+    bool done;
+    if (m_caRestoreCurve) {
+        double progress;
+        if (t < kCaRestoreLeadMs) {
+            progress = kCaRestoreLeadShare * std::min(1.0, t / kCaRestoreJumpMs);
+        } else {
+            const double u = std::min(1.0, (t - kCaRestoreLeadMs) / kCaRestoreRiseMs);
+            progress = kCaRestoreLeadShare + (1.0 - kCaRestoreLeadShare)
+                * (std::exp(kCaRestoreGrowth * u) - 1.0) / (std::exp(kCaRestoreGrowth) - 1.0);
         }
-        break;
+        m_caLevel = m_caRampFrom + (m_caRampTo - m_caRampFrom) * progress;
+        done = t >= kCaRestoreLeadMs + kCaRestoreRiseMs;
+    } else {
+        m_caLevel = m_caRampTo + (m_caRampFrom - m_caRampTo) * std::exp(-t / m_caTauMs);
+        done = std::fabs(m_caLevel - m_caRampTo) < 0.5;
+    }
+    int level = static_cast<int>(std::lround(m_caLevel));
+    if (done) level = static_cast<int>(std::lround(m_caRampTo));
+    if (level != m_caLastSet) {
+        m_pulseAudio->setSinkVolume(m_caSink, level);
+        m_caLastSet = level;
+    }
+    if (!done) return;
+    m_caLevel = m_caRampTo;
+    m_caRampTimer->stop();
+    if (initialVolume != -1 && level == initialVolume) {
+        LOG_INFO("Volume restored to " << initialVolume << "%");
+        caEndSession();
+    }
+}
+
+void MediaController::caHoldExpired() {
+    if (initialVolume == -1) return;
+    // Someone moved the volume or switched output during the conversation: leave it alone.
+    const bool sameSink = m_pulseAudio->getDefaultSink() == m_caSink;
+    const int now = sameSink ? m_pulseAudio->getSinkVolume(m_caSink) : -1;
+    if (!sameSink || now == -1 || std::abs(now - m_caLastSet) >= 3) {
+        LOG_INFO("Volume changed during the conversation, not restoring");
+        m_caRampTimer->stop();
+        caEndSession();
+        return;
+    }
+    caStartRamp(initialVolume, 0, true);
+}
+
+void MediaController::caEndSession() {
+    initialVolume = -1;
+    m_caLastSet = -1;
+    if (!m_caSnapSink.isEmpty() && !connectedDeviceMacAddress.isEmpty()) {
+        m_pulseAudio->enableVolumeSnap(m_caSnapSink, 5);
     }
+    m_caSnapSink.clear();
 }
 
 
